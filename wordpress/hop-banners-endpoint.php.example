/**
 * Optional WordPress MU-plugin / snippet
 * Register: wp-content/mu-plugins/hop-banners.php
 *
 * Exposes GET /wp-json/hop/v1/banners so the Next.js frontend
 * can load hero slides without code changes.
 *
 * Edit banners in WP Admin → Options / ACF Options, or replace
 * the hardcoded $banners array with get_option('hop_banners').
 */

