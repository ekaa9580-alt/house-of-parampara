# ═══════════════════════════════════════════════════════════
# House of Parampara — WooCommerce connection
# Fill these 3 values, set USE_MOCK=false, restart npm run dev
# ═══════════════════════════════════════════════════════════

NEXT_PUBLIC_USE_MOCK=false

# Your WordPress site URL (no trailing slash)
NEXT_PUBLIC_WC_URL=https://YOUR-STORE-DOMAIN.com

# WooCommerce → Settings → Advanced → REST API → Add key (Read/Write)
WC_CONSUMER_KEY=ck_PASTE_YOUR_KEY_HERE
WC_CONSUMER_SECRET=cs_PASTE_YOUR_SECRET_HERE

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=House of Parampara
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/houseofparampara
NEXT_PUBLIC_CONTACT_EMAIL=hello@houseofparampara.com
NEXT_PUBLIC_CONTACT_PHONE=+91 99999 99999

NEXT_PUBLIC_JWT_AUTH_URL=/jwt-auth/v1/token
NEXT_PUBLIC_BANNERS_ENDPOINT=/wp-json/hop/v1/banners
NEXT_PUBLIC_CURRENCY_SYMBOL=₹
NEXT_PUBLIC_CURRENCY_CODE=INR
